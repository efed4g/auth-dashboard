# Örnek dosya — repoya girer. Gerçek değerler .env.development / .env.production
# içindedir ve .gitignore ile dışlanmıştır.
#
#   cp .env.example .env.development
#   cp .env.example .env.production
#
# Vite yalnızca VITE_ ön ekli değişkenleri istemciye aktarır ve dosyayı mode'dan
# seçer (yarn dev -> development, yarn build -> production).
# Buradaki her değer tarayıcıya gider; gizli secret konulmaz.

# Backend kök adresi (kod sonuna /api ekler)
VITE_API_URL=http://localhost:4000

# Vite dev sunucusunun portu — vite.config.js buradan okur
VITE_PORT=3000

# --- Firebase (Google ile giriş) ---
# Firebase Console > Proje Ayarları > Uygulamalarınız > Web app yapılandırması.
# Dev ve production için ayrı proje/web app kullanın: yetkili domainler
# (Authentication > Settings > Authorized domains) ortama göre değişir.
# Boş bırakılırsa uygulama çalışır, sadece Google butonu devre dışı kalır.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
