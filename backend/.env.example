# Örnek dosya — repoya girer. Gerçek değerler .env.development / .env.production
# içindedir ve .gitignore ile dışlanmıştır.
#
#   cp .env.example .env.development
#   cp .env.example .env.production

# --- Temel ---
# Zorunlu: kodda varsayılan port yok, eksikse sunucu açık bir hatayla durur
PORT=4000
# development | production — .env dosyası seçimini ve cookie secure bayrağını belirler
NODE_ENV=development
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/auth_dashboard
# Sequelize SQL loglarını açar
DB_LOGGING=false

# --- Adresler (kodda sabit URL yok) ---
# CORS izni ve şifre sıfırlama linkleri. Virgülle birden fazla origin verilebilir;
# link/yönlendirme üretiminde LİSTENİN İLKİ kanonik adres olarak kullanılır.
FRONTEND_URL=http://localhost:3000
# E-posta doğrulama linklerinin üretildiği adres
BACKEND_URL=http://localhost:4000

# --- Token'lar ---
# Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# JWT_SECRET ile aynı olamaz: farklı olması access token'ın refresh yerine
# kullanılmasını engeller
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Cookie ---
# secure bayrağı NODE_ENV'den türetilir. sameSite deploy topolojisine bağlıdır:
#   aynı site -> lax | strict      farklı domain -> none (secure zorunlu)
COOKIE_SAME_SITE=lax
# Üst domain (ör. .example.com) — genelde boş bırakılır
COOKIE_DOMAIN=

# --- Reverse proxy ---
# Nginx/Heroku arkasındaysa rate limit'in gerçek IP'yi görmesi için
TRUST_PROXY=

# --- Firebase Admin SDK (Google ile giriş) ---
# Firebase Console > Proje Ayarları > Hizmet Hesapları > Yeni özel anahtar.
# Boş bırakılırsa sunucu çalışır, sadece Google girişi devre dışı kalır.
# Dev ve production için ayrı Firebase projesi kullanın.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Satır sonları \n olarak, tamamı çift tırnak içinde
FIREBASE_PRIVATE_KEY=

# --- Seed (opsiyonel) ---
# `yarn seed` ile oluşturulacak admin hesabı
ADMIN_EMAIL=
ADMIN_PASSWORD=
